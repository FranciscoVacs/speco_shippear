# The PR bot (docs/32): build from the repository root with `docker build -f cloud/Dockerfile.prbot .`
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY cloud ./cloud
RUN pip install --no-cache-dir . ./cloud && useradd -m bot
USER bot
ENV PORT=8787
CMD ["sh", "-c", "uvicorn --factory speco_cloud.prbot:create --host 0.0.0.0 --port ${PORT} --proxy-headers"]
