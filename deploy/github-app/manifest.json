{
  "name": "Speco PR Review",
  "url": "https://speco-app.vercel.app",
  "description": "Revisa la intención de cada PR que cambia una spec: qué cambia en el negocio y qué rompe.",
  "hook_attributes": { "url": "https://speco-api.vercel.app/webhooks/github", "active": true },
  "setup_url": "https://speco-api.vercel.app/github/setup",
  "setup_on_update": true,
  "callback_urls": ["https://stwyyoenddghollaqlnh.supabase.co/auth/v1/callback"],
  "public": true,
  "default_permissions": { "contents": "read", "pull_requests": "write", "checks": "write", "metadata": "read", "emails": "read" },
  "default_events": ["pull_request", "push"]
}
